{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('instructor') }}
{% endblock %}

{% block title %}Instructor{% endblock %}

{% block body %}
    <h1>Instructor</h1>

<div class="instructor-page show-page"> {# or new-page / edit-page #}
  <div class="top-buttons">
    <a href="{{ path('app_instructor_index') }}">Back to list</a>
  </div>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ instructor.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ instructor.name }}</td>
            </tr>
            <tr>
                <th>Specialization</th>
                <td>{{ instructor.specialization }}</td>
            </tr>
            <tr>
                <th>Bio</th>
                <td>{{ instructor.bio }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn" href="{{ path('app_instructor_edit', {'id': instructor.id}) }}">Edit</a>

    {{ include('instructor/_delete_form.html.twig') }}
{% endblock %}
