{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('instructor') }}
{% endblock %}

{% block title %}Instructor index{% endblock %}

{% block body %}
    <h1>Instructor index</h1>

<div class="instructor-page index-page">
  <div class="top-buttons">
    <a href="{{ path('app_instructor_new') }}">Create new</a>
  </div>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Specialization</th>
                <th>Bio</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for instructor in instructors %}
            <tr>
                <td>{{ instructor.id }}</td>
                <td>{{ instructor.name }}</td>
                <td>{{ instructor.specialization }}</td>
                <td>{{ instructor.bio }}</td>
                <td>
                    <a class="btn" href="{{ path('app_instructor_show', {'id': instructor.id}) }}">Show</a>
                    <a class="btn" href="{{ path('app_instructor_edit', {'id': instructor.id}) }}">Edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
