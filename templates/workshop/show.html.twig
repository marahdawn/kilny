{% extends 'base.html.twig' %}

{% block title %}Workshop{% endblock %}

{% block body %}

<div class="workshop-page">

    <h1>Workshop</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ workshop.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ workshop.title }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ workshop.description }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ workshop.date ? workshop.date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Time</th>
                <td>{{ workshop.time ? workshop.time|date('H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Duration</th>
                <td>{{ workshop.duration }}</td>
            </tr>
            <tr>
                <th>Location</th>
                <td>{{ workshop.location }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_workshop_index') }}" class="button-link secondary">back to list</a>

    <a href="{{ path('app_workshop_edit', {'id': workshop.id}) }}" class="button-link">Edit</a>

    {{ include('workshop/_delete_form.html.twig') }}

</div>

{% endblock %}
