{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('workshop') }}
{% endblock %}

{% block title %}Workshop{% endblock %}

{% block body %}

<div class="workshop-page">

    <!-- Back button positioned top-left -->
    <a href="{{ path('app_workshop_index') }}" class="back-btn">Back to list</a>

    <h1 style="visibility:hidden; height:0; margin:0;">Workshop</h1>

    <div class="single-card-wrap">
        <div class="card">
            {% if workshop.imageFilename %}
                <img src="{{ asset('uploads/workshops/' ~ workshop.imageFilename) }}" alt="{{ workshop.title }}">
            {% else %}
                <div style="height:240px; background:#e9e6df; border-radius:10px; margin-bottom:18px;"></div>
            {% endif %}

            <div class="details">
                <p><strong>Id:</strong> {{ workshop.id }}</p>
                <p><strong>Title:</strong> {{ workshop.title }}</p>
                <p><strong>Description:</strong> {{ workshop.description }}</p>
                <p><strong>Date:</strong> {{ workshop.date ? workshop.date|date('Y-m-d') : '' }}</p>
                <p><strong>Time:</strong> {{ workshop.time ? workshop.time|date('H:i:s') : '' }}</p>
                <p><strong>Duration:</strong> {{ workshop.duration }}</p>
                <p><strong>Location:</strong> {{ workshop.location }}</p>
                <p><strong>Category:</strong> {{ workshop.category ? workshop.category.name : 'No Category' }}</p>
                <p><strong>Instructor:</strong> {{ workshop.instructor ? workshop.instructor.name : 'No Instructor' }}</p>
            </div>

            <div class="show-actions">
                <a href="{{ path('app_workshop_edit', {'id': workshop.id}) }}" class="card-btn">Edit</a>
                {{ include('workshop/_delete_form.html.twig') }}
            </div>
        </div>
    </div>

</div>

{% endblock %}
