{% extends 'base.html.twig' %}

{% block title %}Workshop index{% endblock %}

{% block body %}

    <div class="workshop-page">

    <h1>Workshop index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Description</th>
                <th>Date</th>
                <th>Time</th>
                <th>Duration</th>
                <th>Location</th>
                <th>Slots</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for workshop in workshops %}
            <tr>
                <td>{{ workshop.id }}</td>
                <td>{{ workshop.title }}</td>
                <td>{{ workshop.description }}</td>
                <td>{{ workshop.date ? workshop.date|date('Y-m-d') : '' }}</td>
                <td>{{ workshop.time ? workshop.time|date('H:i:s') : '' }}</td>
                <td>{{ workshop.duration }}</td>
                <td>{{ workshop.location }}</td>
                <td>{{ workshop.slots }}</td>
                <td>

                    <a href="{{ path('app_workshop_show', {'id': workshop.id}) }}" class="button-link">Show</a>
                    <a href="{{ path('app_workshop_edit', {'id': workshop.id}) }}" class="button-link">Edit</a>

                    
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_workshop_new') }}" class="button-link">Create new</a>

    </div>

{% endblock %}
