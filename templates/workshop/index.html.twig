{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('workshop') }}
{% endblock %}

{% block title %}Workshop index{% endblock %}

{% block body %}

<div class="workshop-page">

    <h1>Workshop index</h1>

    <table class="table">

        <tbody>
        {% for workshop in workshops %}
            <tr>
                <td data-label="Id:">{{ workshop.id }}</td>

                {% if workshop.imageFilename %}
                    <td data-label="Image:">
                        <a href="{{ asset('uploads/workshops/' ~ workshop.imageFilename) }}" target="_blank">
                            <img src="{{ asset('uploads/workshops/' ~ workshop.imageFilename) }}" alt="{{ workshop.title }}">
                        </a>
                    </td>
                {% else %}
                    <td data-label="Image:" class="no-image">No Image</td>
                {% endif %}

                <td data-label="Title:">{{ workshop.title }}</td>
                <td data-label="Description:">{{ workshop.description }}</td>
                <td data-label="Date:">{{ workshop.date ? workshop.date|date('Y-m-d') : '' }}</td>
                <td data-label="Time:">{{ workshop.time ? workshop.time|date('H:i:s') : '' }}</td>
                <td data-label="Duration:">{{ workshop.duration }}</td>
                <td data-label="Location:">{{ workshop.location }}</td>
                <td data-label="Category:">{{ workshop.category ? workshop.category.name : 'No Category' }}</td>
                <td data-label="Instructor:">{{ workshop.instructor ? workshop.instructor.name : 'No Instructor' }}</td>

                <td data-label="Actions:" class="actions-cell">
                    <a href="{{ path('app_workshop_show', {'id': workshop.id}) }}" class="card-btn">Show</a>
                    <a href="{{ path('app_workshop_edit', {'id': workshop.id}) }}" class="card-btn">Edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_workshop_new') }}" class="create-new">Create New</a>

</div>

{% endblock %}
