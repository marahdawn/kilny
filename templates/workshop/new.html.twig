{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('workshop') }}
{% endblock %}

{% block title %}New Workshop{% endblock %}

{% block body %}

<div class="workshop-page">

    <a href="{{ path('app_workshop_index') }}" class="back-btn">Back to list</a>

    <h1 style="visibility:hidden; height:0; margin:0;">Create new Workshop</h1>

    <div class="single-card-wrap">
      <div class="card">
        <h2 style="margin-top:0; color:#264b33; text-align:center;">Create new Workshop</h2>
        {{ include('workshop/_form.html.twig') }}
      </div>
    </div>

</div>

{% endblock %}