{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('reservation') }}
{% endblock %}

{% block title %}Reservation{% endblock %}

{% block body %}
    <h1>Reservation</h1>

<div class="reservation-page show-page">
  <div class="top-buttons">
    <a href="{{ path('app_reservation_index') }}">Back to list</a>
  </div>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ reservation.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ reservation.name }}</td>
            </tr>
            <tr>
                <th>Age</th>
                <td>{{ reservation.age }}</td>
            </tr>
            <tr>
                <th>Phonenumber</th>
                <td>{{ reservation.phonenumber }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ reservation.email }}</td>
            </tr>
            <tr>
                <th>Workshop</th>
                <td>{{ reservation.workshop ? reservation.workshop.title : 'No Workshop' }}</td>
            </tr>
            <tr>
                <th>Reservationtime</th>
                <td>{{ reservation.reservationtime ? reservation.reservationtime|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a class="btn" href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">Edit</a>

    {{ include('reservation/_delete_form.html.twig') }}
</div>

{% endblock %}
