{{ form_start(form) }}
<div class="form-table">

    <div class="form-row">
        <label for="{{ form.name.vars.id }}">Name</label>
        {{ form_widget(form.name) }}
    </div>

    <div class="form-row">
        <label for="{{ form.age.vars.id }}">Age</label>
        {{ form_widget(form.age) }}
    </div>

    <div class="form-row">
        <label for="{{ form.phonenumber.vars.id }}">Phone Number</label>
        {{ form_widget(form.phonenumber) }}
    </div>

    <div class="form-row">
        <label for="{{ form.email.vars.id }}">Email</label>
        {{ form_widget(form.email) }}
    </div>

    <div class="form-row">
        <label for="{{ form.workshop.vars.id }}">Workshop</label>
        {{ form_widget(form.workshop) }}
        </div>

    <div class="form-row">
        <label for="{{ form.reservationtime.vars.id }}">Reservation Time</label>
        {{ form_widget(form.reservationtime) }}
    </div>

</div>

<button class="btn">{{ button_label|default('Save') }}</button>
{{ form_end(form) }}
