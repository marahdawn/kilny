{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('category') }}
{% endblock %}

{% block title %}Category{% endblock %}

{% block body %}
    <h1>Category</h1>

  <div class="category-page show-page"> {# or new-page / edit-page #}
  <div class="top-buttons">
    <a href="{{ path('app_category_index') }}">Back to list</a>
  </div>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ category.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ category.name }}</td>
            </tr>
        </tbody>
    </table>
    <a class="btn" href="{{ path('app_category_edit', {'id': category.id}) }}">Edit</a>

    {{ include('category/_delete_form.html.twig') }}
{% endblock %}
