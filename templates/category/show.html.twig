{# templates/category/show.html.twig #}
{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('category') }}
{% endblock %}

{% block title %}Category{% endblock %}

{% block body %}
    <h1>Category</h1>

    <div class="category-page show-page">
      <div class="top-buttons">
        <a href="{{ path('app_category_index') }}">Back to list</a>
      </div>

      {# Use the same form-like layout as edit so widths/styles match exactly #}
      <div class="form-table">
        <div class="form-row">
          <label>Id</label>
          <div class="form-value">{{ category.id }}</div>
        </div>

        <div class="form-row">
          <label>Name</label>
          <div class="form-value">{{ category.name }}</div>
        </div>
      </div>

      <a class="btn" href="{{ path('app_category_edit', {'id': category.id}) }}">Edit</a>

      {{ include('category/_delete_form.html.twig') }}
    </div>
{% endblock %}
